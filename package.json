{
  "name": "launchscout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "format": "prettier --write src server tests *.ts *.json *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src server tests *.ts *.json *.html *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "openai": "^7.56.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jszip": "^3.10.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
