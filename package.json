{
  "name": "launchscout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "format": "prettier --write src server scripts server-tests tests docs *.ts *.json *.html *.md .github/workflows/*.yml compose.yaml",
    "format:check": "prettier --check src server scripts server-tests tests docs *.ts *.json *.html *.md .github/workflows/*.yml compose.yaml",
    "start": "tsx server/start.ts",
    "test:server": "tsx --test --test-concurrency=1 server-tests/api.test.ts",
    "db:migrate": "tsx server/ops.ts migrate",
    "ops": "tsx server/ops.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.6.0",
    "openai": "^7.56.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "jszip": "^3.10.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
