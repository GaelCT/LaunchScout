# Guest tools work with these left empty. Never prefix server secrets with VITE_.
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
# Generate all four authentication settings with: npm run ops -- secrets
JWT_KEYS=
JWT_ACTIVE_KID=v1
CSRF_SECRET=
ABUSE_HASH_KEY=
# Local Mailpit: smtp://127.0.0.1:1025. Production SMTP must support verified TLS.
SMTP_URL=
MAIL_FROM=LaunchScout <noreply@localhost>
TRUSTED_PROXY_CIDRS=
# Set for docker compose --env-file .env.local up -d
POSTGRES_PASSWORD=
# AI model/pricing/budgets live in ai_policy; see docs/security.md.
OPENAI_API_KEY=
